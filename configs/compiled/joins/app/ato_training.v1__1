{
  "derivations": [
    {
      "expression": "*",
      "name": "*"
    },
    {
      "expression": "(ts - account_id_client_ip_seen_at_ms_min_14d) / 3600000D",
      "name": "hours_since_ip_first_seen"
    },
    {
      "expression": "(ts - account_id_user_agent_seen_at_ms_min_14d) / 3600000D",
      "name": "hours_since_agent_first_seen"
    },
    {
      "expression": "(ts - account_id_seen_at_ms_min_14d) / 3600000D",
      "name": "account_age_hours"
    },
    {
      "expression": "account_id_request_count_sum_7d - account_id_request_count_sum_1h",
      "name": "prior_account_requests_7d"
    },
    {
      "expression": "account_id_write_event_sum_1h / NULLIF(account_id_request_count_sum_1h, 0)",
      "name": "session_write_share"
    },
    {
      "expression": "session_requests * 60000D / GREATEST(ts - session_start_ts, 60000)",
      "name": "session_requests_per_minute"
    },
    {
      "expression": "CAST(PMOD(ts DIV 3600000, 24) AS INT)",
      "name": "session_hour_utc"
    },
    {
      "expression": "CAST(LOWER(user_agent) RLIKE 'python|curl|wget|go-http|httpx|okhttp|java/|libwww|scrapy|bot' AS INT)",
      "name": "is_automation_agent"
    },
    {
      "expression": "CAST(COALESCE((ts - account_id_seen_at_ms_min_14d) / 3600000D >= 24 AND (ts - account_id_client_ip_seen_at_ms_min_14d) / 3600000D < 1 AND (ts - account_id_user_agent_seen_at_ms_min_14d) / 3600000D < 1, FALSE) AS INT)",
      "name": "rule_new_ip_and_device"
    },
    {
      "expression": "CAST(COALESCE(account_id_auth_failure_event_sum_1h >= 3, FALSE) AS INT)",
      "name": "rule_auth_failures"
    },
    {
      "expression": "CAST(COALESCE(LOWER(user_agent) RLIKE 'python|curl|wget|go-http|httpx|okhttp|java/|libwww|scrapy|bot' AND account_id_write_event_sum_1h >= 1, FALSE) AS INT)",
      "name": "rule_scripted_writes"
    },
    {
      "expression": "CAST(COALESCE(client_ip_account_id_approx_unique_count_7d >= 3, FALSE) AS INT)",
      "name": "rule_shared_ip"
    },
    {
      "expression": "CAST(COALESCE((ts - account_id_seen_at_ms_min_14d) / 3600000D >= 24 AND (ts - account_id_client_ip_seen_at_ms_min_14d) / 3600000D < 1 AND (ts - account_id_user_agent_seen_at_ms_min_14d) / 3600000D < 1, FALSE) AS INT) + CAST(COALESCE(account_id_auth_failure_event_sum_1h >= 3, FALSE) AS INT) + CAST(COALESCE(LOWER(user_agent) RLIKE 'python|curl|wget|go-http|httpx|okhttp|java/|libwww|scrapy|bot' AND account_id_write_event_sum_1h >= 1, FALSE) AS INT) + CAST(COALESCE(client_ip_account_id_approx_unique_count_7d >= 3, FALSE) AS INT)",
      "name": "rule_score"
    }
  ],

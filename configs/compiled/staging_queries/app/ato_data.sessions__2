  "query": "\nSELECT\n    session_id,\n    account_id,\n    client_ip,\n    user_agent,\n    MIN(event_ts) AS session_start_ts,\n    MAX(event_ts) AS session_end_ts,\n    COUNT(*) AS session_requests,\n    MAX(scenario) AS scenario,\n    CAST(\n        MAX(scenario) IN ('ato_scripted', 'ato_stealth')\n        AND CAST(PMOD(XXHASH64(session_id, 'confirmed'), 100) AS INT) < 85\n        AS INT\n    ) AS is_ato,\n    ds\nFROM public_demo_data.app_ato_data_activity__2\nWHERE ds BETWEEN {{ start_date }} AND {{ end_date }}\nGROUP BY session_id, account_id, client_ip, user_agent, ds\n",

    "name": "ato.ato_data.activity__1",
    "outputNamespace": "public_demo_data",
    "sourceFile": "staging_queries/ato/ato_data.py",
    "team": "ato",
    "version": "1"
  },
  "query": "\nWITH raw AS (\n    SELECT\n        *,\n        ROW_NUMBER() OVER (PARTITION BY event_id ORDER BY ingested_at) AS copy_number\n    FROM public_demo_app.ui_access_logs_iceberg\n    WHERE ds BETWEEN DATE_FORMAT(DATE_SUB(TO_DATE({{ start_date }}), 14), 'yyyy-MM-dd')\n                 AND {{ end_date }}\n),\norganic AS (\n    SELECT\n        event_id,\n        COALESCE(NULLIF(TRIM(user_id), ''), CONCAT('ip:', client_ip)) AS account_id,\n        client_ip,\n        COALESCE(NULLIF(TRIM(user_agent), ''), 'unknown') AS user_agent,\n        http_method,\n        path,\n        status_code,\n        event_ts,\n        ds\n    FROM raw\n    WHERE copy_number = 1 AND client_ip IS NOT NULL AND client_ip != ''\n),\naccount_days AS (\n    SELECT account_id, ds, MAX_BY(user_agent, event_ts) AS usual_user_agent\n    FROM organic\n    GROUP BY account_id, ds\n),\nestablished AS (\n    SELECT d.account_id, d.ds, d.usual_user_agent\n    FROM account_days d\n    LEFT SEMI JOIN account_days p\n      ON p.account_id = d.account_id\n     AND TO_DATE(p.ds) BETWEEN DATE_SUB(TO_DATE(d.ds), 14)\n                           AND DATE_SUB(TO_DATE(d.ds), 1)\n    WHERE d.ds BETWEEN {{ start_date }} AND {{ end_date }}\n),\nscenarios AS (\n    SELECT\n        account_id,\n        ds,\n        usual_user_agent,\n        CASE\n            WHEN bucket < 15 THEN 'ato_scripted'\n            WHEN bucket < 30 THEN 'ato_stealth'\n            WHEN bucket < 55 THEN 'new_device'\n            ELSE 'vpn_new_device'\n        END AS scenario\n    FROM (SELECT *, CAST(PMOD(XXHASH64(account_id, ds, 'scenario'), 1000) AS INT) AS bucket FROM established) e\n    WHERE bucket < 70\n),\nplans AS (\n    SELECT\n        account_id,\n        ds,\n        scenario,\n        CASE scenario\n            -- Credential-stuffing infrastructure: 24 hosting IPs reused across victims.\n            WHEN 'ato_scripted' THEN CONCAT('185.220.', 100 + CAST(PMOD(XXHASH64(account_id, ds, 'subnet'), 4) AS INT), '.', 10 + CAST(PMOD(XXHASH64(account_id, ds, 'host'), 6) AS INT))\n            -- Residential proxies and home networks: effectively unique per session.\n            WHEN 'ato_stealth' THEN CONCAT('98.', CAST(PMOD(XXHASH64(account_id, ds, 'o2'), 256) AS INT), '.', CAST(PMOD(XXHASH64(account_id, ds, 'o3'), 256) AS INT), '.', 1 + CAST(PMOD(XXHASH64(account_id, ds, 'o4'), 254) AS INT))\n            WHEN 'new_device' THEN CONCAT('73.', CAST(PMOD(XXHASH64(account_id, ds, 'o2'), 256) AS INT), '.', CAST(PMOD(XXHASH64(account_id, ds, 'o3'), 256) AS INT), '.', 1 + CAST(PMOD(XXHASH64(account_id, ds, 'o4'), 254) AS INT))\n            -- Commercial VPN egress: 40 IPs legitimately shared by many accounts.\n            ELSE CONCAT('104.28.', 30 + CAST(PMOD(XXHASH64(account_id, ds, 'subnet'), 2) AS INT), '.', 10 + CAST(PMOD(XXHASH64(account_id, ds, 'host'), 20) AS INT))\n        END AS client_ip,\n        CASE scenario\n            WHEN 'ato_scripted' THEN ELEMENT_AT(ARRAY('python-requests/2.32.3', 'curl/8.7.1', 'Go-http-client/1.1', 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/129.0.0.0 Safari/537.36', 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/129.0.0.0 Safari/537.36'), 1 + CAST(PMOD(XXHASH64(account_id, ds, 'agent'), 5) AS INT))\n            WHEN 'ato_stealth' THEN usual_user_agent\n            ELSE ELEMENT_AT(ARRAY('Mozilla/5.0 (iPhone; CPU iPhone OS 18_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/18.0 Mobile/15E148 Safari/604.1', 'Mozilla/5.0 (Macintosh; Intel Mac OS X 14.6; rv:131.0) Gecko/20100101 Firefox/131.0', 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/129.0.0.0 Safari/537.36 Edg/129.0.0.0', 'Mozilla/5.0 (Linux; Android 14; Pixel 8) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/129.0.0.0 Mobile Safari/537.36'), 1 + CAST(PMOD(XXHASH64(account_id, ds, 'agent'), 4) AS INT))\n        END AS user_agent,\n        CASE scenario\n            WHEN 'ato_scripted' THEN ELEMENT_AT(ARRAY(0, 1, 2, 3, 4, 5, 22, 23, 13, 17), 1 + CAST(PMOD(XXHASH64(account_id, ds, 'hour'), 10) AS INT))\n            WHEN 'ato_stealth' THEN 14 + CAST(PMOD(XXHASH64(account_id, ds, 'hour'), 8) AS INT)\n            -- One in five new devices is someone travelling, active overnight UTC.\n            WHEN 'new_device' THEN IF(CAST(PMOD(XXHASH64(account_id, ds, 'travel'), 5) AS INT) = 0, CAST(PMOD(XXHASH64(account_id, ds, 'hour'), 6) AS INT), 14 + CAST(PMOD(XXHASH64(account_id, ds, 'hour'), 9) AS INT))\n            ELSE 14 + CAST(PMOD(XXHASH64(account_id, ds, 'hour'), 9) AS INT)\n        END AS start_hour,\n        CAST(PMOD(XXHASH64(account_id, ds, 'minute'), 45) AS INT) AS start_minute,\n        CASE scenario\n            -- One in eight scripted attacks already holds a valid password.\n            WHEN 'ato_scripted' THEN CAST(PMOD(XXHASH64(account_id, ds, 'failures'), 8) AS INT)\n            ELSE IF(CAST(PMOD(XXHASH64(account_id, ds, 'failures'), 4) AS INT) = 0, 1, 0)\n        END AS failed_logins,\n        CASE scenario\n            WHEN 'ato_scripted' THEN 6 + CAST(PMOD(XXHASH64(account_id, ds, 'actions'), 20) AS INT)\n            ELSE 3 + CAST(PMOD(XXHASH64(account_id, ds, 'actions'), 12) AS INT)\n        END AS actions,\n        CASE scenario WHEN 'ato_scripted' THEN 45 WHEN 'ato_stealth' THEN 15 ELSE 8 END AS write_percent,\n        -- Milliseconds between requests: scripted attacks move at machine speed.\n        CASE scenario\n            WHEN 'ato_scripted' THEN 1500 + CAST(PMOD(XXHASH64(account_id, ds, 'pace'), 2500) AS INT)\n            ELSE 15000 + CAST(PMOD(XXHASH64(account_id, ds, 'pace'), 45000) AS INT)\n        END AS step_ms\n    FROM scenarios\n),\nsteps AS (\n    SELECT\n        p.*,\n        step,\n        step <= failed_logins + 1 AS is_login,\n        CAST(PMOD(XXHASH64(account_id, ds, step, 'write'), 100) AS INT) < write_percent AS is_write\n    FROM plans p\n    LATERAL VIEW EXPLODE(SEQUENCE(1, failed_logins + 1 + actions)) s AS step\n),\ninjected AS (\n    SELECT\n        SHA2(CONCAT_WS('|', 'simulated', account_id, ds, CAST(step AS STRING)), 256) AS event_id,\n        account_id,\n        client_ip,\n        user_agent,\n        CASE\n            WHEN is_login THEN 'POST'\n            WHEN is_write THEN ELEMENT_AT(ARRAY('POST', 'PUT', 'DELETE'), 1 + CAST(PMOD(XXHASH64(account_id, ds, step, 'method'), 3) AS INT))\n            ELSE 'GET'\n        END AS http_method,\n        CASE\n            WHEN is_login THEN '/api/auth/login'\n            WHEN is_write THEN ELEMENT_AT(ARRAY('/api/tokens', '/api/users/me/email', '/api/users/me/mfa', '/api/settings/webhooks'), 1 + CAST(PMOD(XXHASH64(account_id, ds, step, 'path'), 4) AS INT))\n            ELSE ELEMENT_AT(ARRAY('/', '/workflows', '/services/hub/api/confs', '/services/hub/api/users/me'), 1 + CAST(PMOD(XXHASH64(account_id, ds, step, 'path'), 4) AS INT))\n        END AS path,\n        IF(step <= failed_logins, 401, 200) AS status_code,\n        UNIX_TIMESTAMP(TO_TIMESTAMP(ds, 'yyyy-MM-dd')) * 1000 + start_hour * 3600000 + start_minute * 60000 + step * step_ms AS event_ts,\n        CONCAT('simulated:', account_id, ':', ds) AS session_id,\n        scenario,\n        ds\n    FROM steps\n)\nSELECT\n    event_id,\n    account_id,\n    client_ip,\n    user_agent,\n    http_method,\n    path,\n    status_code,\n    event_ts,\n    SHA2(CONCAT_WS('|', account_id, client_ip, user_agent, CAST(FLOOR(event_ts / 3600000) AS STRING)), 256)\n        AS session_id,\n    'organic' AS scenario,\n    ds\nFROM organic\nWHERE ds BETWEEN {{ start_date }} AND {{ end_date }}\nUNION ALL\nSELECT\n    event_id,\n    account_id,\n    client_ip,\n    user_agent,\n    http_method,\n    path,\n    status_code,\n    event_ts,\n    session_id,\n    scenario,\n    ds\nFROM injected\n",
  "tableDependencies": [
    {
      "endOffset": {
        "length": 0,
        "timeUnit": 1
      },
      "startOffset": {
        "length": 0,
        "timeUnit": 1
      },
      "tableInfo": {
        "partitionColumn": "ds",
        "partitionInterval": {
          "length": 1,
          "timeUnit": 1
        },
        "table": "public_demo_app.ui_access_logs_iceberg"
      }
    }
  ]
}
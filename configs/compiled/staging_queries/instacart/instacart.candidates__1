  "query": "\nWITH train_items AS (\n    SELECT\n        order_id,\n        product_id\n    FROM parquet.`s3://zipline-public-demo-curated/kaggle_instacart/iceberg/order_products_train/data/`\n),\nnext_basket AS (\n    SELECT o.user_id, t.product_id, o.ds\n    FROM train_items t\n    JOIN public_demo_data.instacart_instacart_orders__1 o ON t.order_id = o.order_id\n    WHERE o.eval_set = 'train' AND PMOD(o.user_id, 100) < 100\n),\nlabelled_users AS (\n    SELECT user_id, MAX(ds) AS ds FROM next_basket GROUP BY user_id\n),\ncatalogue AS (\n    -- Read all prior baskets, independent of materialized feature history.\n    SELECT DISTINCT o.user_id, i.product_id\n    FROM parquet.`s3://zipline-public-demo-curated/kaggle_instacart/iceberg/order_products_prior/data/` i\n    JOIN parquet.`s3://zipline-public-demo-curated/kaggle_instacart/iceberg/orders/data/` o ON i.order_id = o.order_id\n    WHERE o.eval_set = 'prior' AND PMOD(o.user_id, 100) < 100\n)\nSELECT\n    c.user_id,\n    c.product_id,\n    CONCAT(CAST(c.user_id AS STRING), '-', CAST(c.product_id AS STRING)) AS candidate_id,\n    IF(n.product_id IS NOT NULL, 1, 0) AS in_next_basket,\n    u.ds\nFROM catalogue c\nJOIN labelled_users u ON c.user_id = u.user_id\nLEFT JOIN next_basket n\n       ON n.user_id = c.user_id AND n.product_id = c.product_id\nWHERE u.ds BETWEEN {{ start_date }} AND {{ end_date }}\n",

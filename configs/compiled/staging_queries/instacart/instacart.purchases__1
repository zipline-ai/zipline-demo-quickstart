  "query": "\nWITH items AS (\n    SELECT\n        order_id,\n        product_id,\n        add_to_cart_order,\n        reordered\n    FROM parquet.`s3://zipline-public-demo-curated/kaggle_instacart/iceberg/order_products_prior/data/`\n)\nSELECT\n    o.user_id,\n    i.product_id,\n    i.order_id,\n    i.add_to_cart_order,\n    i.reordered,\n    o.order_number,\n    o.order_dow,\n    o.order_hour_of_day,\n    -- Midnight plus the hour the basket was placed, in epoch millis, which is what a\n    -- temporal join reads.\n    UNIX_TIMESTAMP(TO_TIMESTAMP(o.ds, 'yyyy-MM-dd')) * 1000\n        + o.order_hour_of_day * 3600000 AS purchased_at_ms,\n    o.ds\nFROM items i\nJOIN public_demo_data.instacart_instacart_orders__1 o ON i.order_id = o.order_id\nWHERE o.eval_set = 'prior'\n  AND PMOD(o.user_id, 100) < 100\n  AND o.ds BETWEEN {{ start_date }} AND {{ end_date }}\n",
